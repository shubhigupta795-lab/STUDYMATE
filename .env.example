# Required
GEMINI_API_KEY=

# Gemini models. Leave these defaults unless you intentionally want to change them.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
ENABLE_CURRENT_WEB_RESEARCH=true

# PostgreSQL
POSTGRES_DB=studymate
POSTGRES_USER=studymate
POSTGRES_PASSWORD=studymate
DATABASE_URL=postgresql+psycopg://studymate:studymate@localhost:5432/studymate
